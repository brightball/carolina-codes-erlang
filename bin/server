#!/usr/bin/env bash
# Launch the Erlang + Nova polyglot API.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if ! command -v erl >/dev/null 2>&1; then
  ERL_ROOT="${ERL_ROOT:-$HOME/.local/share/mise/installs/erlang/latest}"
  export PATH="$ERL_ROOT/bin:${HOME}/.local/bin:${PATH}"
fi
export PATH="${HOME}/.local/bin:${PATH}"
cd "$ROOT"
if [[ ! -d "$ROOT/_build/default/lib/carolina/ebin" ]]; then
  rebar3 compile
fi
CONFIG=()
if [[ -f "$ROOT/config/sys.config" ]]; then
  CONFIG=(-config "$ROOT/config/sys")
fi
exec erl -pa "$ROOT"/_build/default/lib/*/ebin "${CONFIG[@]}" -noshell -s carolina main
